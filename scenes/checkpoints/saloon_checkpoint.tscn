[ext_resource type="Script" path="res://scenes/checkpoints/saloon_checkpoint.gd" id="1_saloon"]

[sub_resource type="RectangleShape2D" id="Rect_interact"]
size = Vector2(440, 300)

; The origin sits on the ground at the middle of the doorway, so a saloon is
; placed by dropping it on a ground line — same convention as the Player, whose
; origin is at its feet. Everything below is a placeholder rectangle in the
; spirit of the rest of the level; the warm-vs-shuttered read is what has to
; survive into the hand-painted art, not these colours.
[node name="SaloonCheckpoint" type="Area2D"]
collision_layer = 32
collision_mask = 2
script = ExtResource("1_saloon")

[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -150)
shape = SubResource("Rect_interact")

; Behind the play plane. Without this the building draws over the player — a
; saloon is placed after the Player in the level's tree, and everything in the
; level sits at z 0 — so walking up to the door hides you behind the facade. -1
; is still ahead of every parallax layer (sky -100 up to the play plane) and
; behind the foreground dust overlay at +40. The Prompt is a sibling at 0 on
; purpose, so it reads over the roof rather than under it.
[node name="Building" type="Node2D" parent="."]
z_index = -1

